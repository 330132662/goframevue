# 接口验证 encrypt
VITE_ENCRYPT = gofly@888
# true/false 是否开启动态token(动态token开启后，每次请求token都一样，且每个token都有时效性),也称一次性token（OTT）
VITE_OTTOKEN = true

# 生产环境接口域名（对应 config.js 的 domain，留空表示与前端同源部署）
VITE_API_DOMAIN = http://qq.com
# 本地/测试环境接口地址（对应 config.js 的 localhost，可改成测试线的地址）
VITE_API_BASE_URL = http://localhost:9999 # 应该没用到